    "scenes": [
      {
        "scene": "خيام منى، وأنوار كثيرة كثيرة.",
        "text": "أنا حصاةٌ من منى. رأيت حجة الوداع، حين حجّ رسول الله ﷺ ومعه آلاف المسلمين من كل مكان."
      },
      {
        "scene": "نور أبيض على جمل، وأنوار حوله.",
        "text": "وكان الفضل بن عباس رديفَ رسول الله ﷺ على راحلته. فجاءت امرأة من قبيلة خثعم تسأل."
      },
      {
        "scene": "نور دافئ يقترب من النور الأبيض.",
        "text": "قالت: «يا رسول الله، إن فريضة الله على عباده في الحج أدركت أبي شيخًا كبيرًا لا يثبت على الراحلة، أفأحج عنه؟»… فماذا قال ﷺ؟"
      },
      {
        "scene": "الضياء يملأ المكان.",
        "text": "قال: «نعم». فما أجمل قلبها! جاءت تحج، وهي تفكّر في أبيها الكبير الذي لا يستطيع السفر."
      },
      {
        "scene": "الكعبة، وأنوار تطوف.",
        "text": "فتعلّم المسلمون من سؤالها أن الولد يحج عن والده الذي عجز عن الحج. وكان ذلك في حجة الوداع."
      },
      {
        "scene": "فجر ذهبي، والكعبة، وضياء.",
        "text": "وأنا ما زلت أذكر سؤالها: برٌّ بأبيها وحرصٌ على دينه. فكن مثلها، تذكّر والديك في كل خير تعمله!"
      }
    ],
    "choice": {
      "after_scene": 3,
      "question": "سألت: أفأحج عن أبي الشيخ الكبير؟",
      "options": [
        {
          "text": "قال: نعم",

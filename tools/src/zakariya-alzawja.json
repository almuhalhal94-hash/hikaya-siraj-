    "scenes": [
      {
        "scene": "المحراب، ونور أبيض يصلي.",
        "text": "أنا قنديلٌ في بيت النبي زكريا عليه السلام. كان زكريا شيخًا كبيرًا، وكانت امرأته لا تلد، ومضت سنون طويلة ولم يُرزقا ولدًا."
      },
      {
        "scene": "بيت هادئ، ونوران.",
        "text": "قال زكريا يصف حالهما: {{19:8|6-8}}. لكنهما لم يتركا العبادة، وبقيا يرجوان رحمة الله."
      },
      {
        "scene": "المحراب ليلًا، ونور يدعو.",
        "text": "فدعا زكريا ربه: {{21:89|4-10}}… فماذا كان جواب الله؟"
      },
      {
        "scene": "الضياء يملأ المحراب.",
        "text": "{{21:90|0-7}}. أصلح الله امرأته فصارت تلد بعد طول السنين، ووُلد يحيى عليه السلام!"
      },
      {
        "scene": "نوران، ومصحف مفتوح، والقنديل يتوهج.",
        "text": "ثم أثنى الله عليهما وعلى أهل بيتهما: {{21:90|9-20}}. كانت مع زوجها يتسابقان إلى الخيرات، ويدعوان الله رجاءً وخوفًا."
      },
      {
        "scene": "فجر ذهبي، وأنوار في البيت.",
        "text": "وأنا ما زلت أضيء لهذا البيت الصالح: زوجان يتعاونان على طاعة الله، فأعطاهما الله ما تمنّيا."
      }
    ],

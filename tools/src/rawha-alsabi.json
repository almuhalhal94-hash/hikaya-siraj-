    "scenes": [
      {
        "scene": "طريق في الصحراء، وجمال، وأنوار.",
        "text": "أنا جملٌ في ركب من المسلمين يسير إلى الحج. وفي الركب امرأة تحمل صبيًّا صغيرًا."
      },
      {
        "scene": "الركب يلتقي بنور أبيض.",
        "text": "فلقينا رسول الله ﷺ بمكان يقال له الروحاء، فقال: «من القوم؟» قالوا: المسلمون. فقالوا: من أنت؟ قال: «رسول الله»."
      },
      {
        "scene": "نور دافئ يرفع نورًا صغيرًا.",
        "text": "«فرفعت إليه امرأة صبيًّا، فقالت: ألهذا حج؟»… فماذا قال ﷺ؟"
      },
      {
        "scene": "الضياء يملأ المكان.",
        "text": "قال: «نعم، ولك أجر». فللصبي حجّه، ولأمه أجر لأنها حملته وأعانته عليه."
      },
      {
        "scene": "الركب يسير على الطريق.",
        "text": "فسارت الأم بصبيها فرحة، تعلّمه العبادة وهو صغير."
      },
      {
        "scene": "فجر عند الكعبة، وأنوار تطوف.",
        "text": "وأنا ما زلت أذكر تلك الأم الحكيمة: سألت لتتعلّم، وعوّدت ابنها على العبادة منذ صغره."
      }
    ],
    "choice": {

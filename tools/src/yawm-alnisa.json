    "scenes": [
      {
        "scene": "المسجد، وأنوار كثيرة حول نور أبيض.",
        "text": "أنا مكانٌ في المدينة كانت تجتمع فيه النساء. كان الرجال يجلسون مع رسول الله ﷺ كثيرًا يتعلّمون منه، والنساء يردن أن يتعلّمن مثلهم."
      },
      {
        "scene": "أنوار دافئة مجتمعة تطلّ من الجدار.",
        "text": "فقالت النساء لرسول الله ﷺ: «غلبنا عليك الرجال، فاجعل لنا يومًا من نفسك»… فماذا قال ﷺ؟"
      },
      {
        "scene": "نور أبيض بين أنوار دافئة، والضياء.",
        "text": "«فوعدهن يومًا لقيهن فيه، فوعظهن وأمرهن». جعل لهن يومًا خاصًّا يعلّمهن فيه!"
      },
      {
        "scene": "الأنوار تستمع، ونوران صغيران.",
        "text": "وكان مما قال لهن: أن المرأة التي يموت لها ثلاثة من أولادها فتصبر، يكونون لها حجابًا من النار."
      },
      {
        "scene": "نور دافئ يسأل، والضياء يزداد.",
        "text": "فقالت امرأة: «واثنين؟» قال: «واثنين». لم تستحِ أن تسأل، فكان سؤالها بشارةً لكل أم صبرت. فالسؤال الطيب مفتاح العلم!"
      },
      {
        "scene": "فجر، وأنوار دافئة كثيرة.",
        "text": "وأنا ما زلت أذكر ذلك اليوم: نساء حريصات على العلم، طلبن فأُجبن، وسألن فتعلّمن، ثم علّمن من بعدهن."
      }
    ],

    "scenes": [
      {
        "scene": "تلال مكة تحت سماء الفجر، ونور كبير (إبراهيم عليه السلام) وحده.",
        "text": "أنا الكبشُ الذي جعله اللهُ فداءً في يومٍ عظيم. وحكايتي مع نبيَّين كريمين: إبراهيمَ وابنِه إسماعيلَ عليهما السلام. كان إبراهيمُ قد دعا ربَّه: {{37:100}}، فبشّره الله: {{37:101}}."
      },
      {
        "scene": "نور كبير ونور صغير يمشيان معًا بين التلال.",
        "text": "وكبر الغلام حتى صار يمشي مع أبيه ويعينه. ثم رأى إبراهيمُ في منامه أنه يذبح ابنَه! ورؤيا الأنبياء وحيٌ من الله، فهي أمرٌ لا بدّ أن يُطاع."
      },
      {
        "scene": "ليل وقمر، والنوران متقاربان.",
        "text": "فجاء الأبُ إلى ابنه يشاوره بلطف: {{37:102|5-14}}. ماذا سيقول الابنُ لأبيه؟"
      },
      {
        "scene": "النوران متجاوران قريبان من الأرض، والسماء ساكنة.",
        "text": "فقال الابنُ الحليم: {{37:102|17-27}}. فلمّا استسلما لأمر الله جميعًا، الأبُ والابن، أضجعه أبوه على جبينه…"
      },
      {
        "scene": "ضياء ينزل من السماء، وكبش أبيض مضيء يظهر بجانب النورين.",
        "text": "فناداه الله: {{37:104}} {{37:105|0-2}}. وهنا جئتُ أنا! قال الله تعالى: {{37:107}}. فكنتُ الفداءَ مكانَ الابن، ونجّاه اللهُ بصبره وطاعته."
      },
      {
        "scene": "فجر ذهبي، والنوران فرحان، والكبش مضيء بينهما.",
        "text": "وأثنى الله على إبراهيم فقال: {{37:109}} {{37:110}}. فهذه حكايةُ أبٍ أطاع ربَّه، وابنٍ صبر وأطاع، يتذكّرها المسلمون كلَّ عيدِ أضحى."
      }
    ],
